# Copy this file to .env.local and fill in values for your local environment.
# .env.local is gitignored and must NOT be committed.

# Gateway base URL for SSR — browser requests use "/api" which the Shell proxy
# rewrites to the gateway. Server-side renders need an absolute URL.
# Local dev:  http://localhost:5000/api
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api
