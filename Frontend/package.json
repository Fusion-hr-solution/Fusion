{
  "name": "frontend",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "dev:owned": "turbo dev --filter=shell --filter=core --filter=platform --filter=performance",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "type-check": "turbo type-check",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.4.4"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=18"
  }
}
