# ==============================================================================
# Docker Compose — Environment Variables
# ==============================================================================
# Copy this file to `.env` and fill in the values.
# `.env` is gitignored and should NEVER be committed.
# ==============================================================================

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=fusion
POSTGRES_PASSWORD=root
POSTGRES_HOST=postgres

# ─── JWT Authentication ───────────────────────────────────────────────────────
# IMPORTANT: Use a strong, random secret in production (min 32 characters)
JWT_SECRET=YourSuperSecretKeyForDevelopmentOnly123!

# ─── Backend Service Ports (host:container mapping) ──────────────────────────
GATEWAY_PORT=5000
IDENTITY_PORT=5101
TRAINING_PORT=5201
COREHR_PORT=5301

# ─── Frontend Ports ──────────────────────────────────────────────────────────
FRONTEND_SHELL_PORT=3000
FRONTEND_CORE_PORT=3002

# ─── Database Names ──────────────────────────────────────────────────────────
IDENTITY_DB=fusion_identity
TRAINING_DB=fusion_training
COREHR_DB=fusion_corehr

# ─── Feature Flags ───────────────────────────────────────────────────────────
# Set to true to auto-migrate databases on startup
DATABASE_AUTO_MIGRATE=true

# ─── Logging ─────────────────────────────────────────────────────────────────
# Options: Verbose, Debug, Information, Warning, Error, Fatal
LOG_LEVEL=Information
