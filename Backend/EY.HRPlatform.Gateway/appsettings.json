{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "EY.HRPlatform.Identity",
    "Audience": "EY.HRPlatform"
  },
  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/identity/{**catch-all}"
        }
      },
      "corehr-workforce-accounts-route": {
        "ClusterId": "identity-cluster",
        "AuthorizationPolicy": "default",
        "Metadata": {
          "owner": "identity",
          "note": "Implemented in Identity service. The /api/corehr/employees/workforce-accounts prefix is a UX convenience — Core does not serve this path and must not call Identity to assemble EmployeeDetails."
        },
        "Match": {
          "Path": "/api/corehr/employees/workforce-accounts/{**catch-all}"
        }
      },
      "training-route": {
        "ClusterId": "training-cluster",
        "Match": {
          "Path": "/api/training/{**catch-all}"
        }
      },
      "interview-route": {
        "ClusterId": "interview-cluster",
        "Match": {
          "Path": "/api/interview/{**catch-all}"
        }
      },
      "corehr-health-route": {
        "ClusterId": "corehr-cluster",
        "Match": {
          "Path": "/api/corehr/health/{**remainder}"
        },
        "Transforms": [{ "PathRemovePrefix": "/api/corehr" }]
      },
      "corehr-swagger-route": {
        "ClusterId": "corehr-cluster",
        "Match": {
          "Path": "/api/corehr/swagger/{**catch-all}"
        }
      },
      "corehr-route": {
        "ClusterId": "corehr-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/corehr/{**catch-all}"
        }
      },
      "performance-health-route": {
        "ClusterId": "performance-cluster",
        "Match": {
          "Path": "/api/performance/health/{**remainder}"
        },
        "Transforms": [{ "PathRemovePrefix": "/api/performance" }]
      },
      "performance-swagger-route": {
        "ClusterId": "performance-cluster",
        "Match": {
          "Path": "/api/performance/swagger/{**catch-all}"
        }
      },
      "performance-route": {
        "ClusterId": "performance-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/performance/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5101/"
          }
        }
      },
      "training-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5201/"
          }
        }
      },
      "interview-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5209/"
          }
        }
      },
      "corehr-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5301/"
          }
        }
      },
      "performance-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5401/"
          }
        }
      }
    }
  },
  "AllowedHosts": "*"
}
