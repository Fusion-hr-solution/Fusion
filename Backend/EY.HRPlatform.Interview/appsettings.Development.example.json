{
  "ConnectionStrings": {
    "InterviewDb": "Host=localhost;Port=5432;Database=hris_interview;Username=postgres;Password=YOUR_PASSWORD"
  },
  "Database": {
    "AutoMigrate": true
  },
  "Jwt": {
    "Secret": "YOUR_JWT_SECRET",
    "Issuer": "EY.HRPlatform.Identity",
    "Audience": "EY.HRPlatform"
  },
  "CandidateInvitations": {
    "PublicBaseUrl": "http://localhost:3000/interview/candidate/start",
    "Email": {
      "Enabled": false,
      "SmtpHost": "",
      "SmtpPort": 587,
      "UseSsl": true,
      "Username": "",
      "Password": "",
      "FromEmail": "no-reply@example.com",
      "FromName": "EY HR Platform",
      "ReplyToEmail": "",
      "UseHtmlBody": true,
      "Subject": "Interview invitation"
    }
  },
  "Networking": {
    "ForwardedHeaders": {
      "ForwardLimit": 2,
      "KnownProxies": [
        "127.0.0.1",
        "::1"
      ],
      "KnownNetworks": [
        "172.18.0.0/16"
      ]
    }
  },
  "CandidateTimeline": {
