  "Groq": {
    "ApiKey": "",
    "Grading": {
      "PassCount": 3,
      "MaxScoreSpread": 2.5,
      "LowConfidenceThreshold": 0.7,
      "PassTemperature": 0.4
    }
  },
  "Judge0": {
    "BaseUrl": "http://localhost:2358",
    "AuthToken": ""
