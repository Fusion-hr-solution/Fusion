{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": ["FromLogContext"],
    "Properties": {
      "Application": "EY.HRPlatform.Performance"
    }
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "EY.HRPlatform.Identity",
    "Audience": "EY.HRPlatform"
  },
  "ServiceUrls": {
    "CoreApiBaseUrl": ""
  },
  "ConnectionStrings": {
    "PerformanceDb": ""
  },
  "Database": {
    "AutoMigrate": false
  },
  "Reminders": {
    "Enabled": true,
    "SweepIntervalMinutes": 60,
    "DueSoonWindowDays": 3
  },
  "ScheduledJobs": {
    "Enabled": true,
    "InactivitySweepIntervalMinutes": 720,
    "InactivityThresholdDays": 7,
    "AttachmentCleanupIntervalMinutes": 360,
    "AttachmentAbandonmentHours": 24
  },
  "Attachments": {
    "Enabled": true,
    "StorageRoot": "App_Data/attachments",
    "MaxSizeBytes": 10485760,
    "AbandonmentAgeHours": 24
  },
  "AllowedHosts": "*"
}
