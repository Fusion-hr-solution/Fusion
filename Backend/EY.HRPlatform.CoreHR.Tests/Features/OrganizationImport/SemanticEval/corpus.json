{
  "version": 1,
  "notes": "Ground truth for organization-import semantic assistance. Each expectation is the Fusion meaning of a source header (fields), a source type label (types) or the hierarchy encoding (shape); \"abstain\" means a correct system must not guess. Only questions deterministic interpretation leaves open are asked of the provider; expectations it already resolved are reported as deterministic.",
  "cases": [
    {
      "name": "fusion-template",
      "about": "Canonical Fusion headers and types: nothing should reach the provider.",
      "headers": ["Fusion OrgUnit ID", "Business Code", "Name", "Type", "Parent Business Code"],
      "rows": [
        ["", "ACME", "Acme Group", "Organization", ""],
        ["", "FIN", "Finance", "Division", "ACME"],
        ["", "FIN-AP", "Payables", "Department", "FIN"],
        ["", "FIN-AP-1", "Payables Team", "Team", "FIN-AP"]
      ],
      "expect": {
        "fields": { "Business Code": "businessCode", "Name": "name", "Type": "type", "Parent Business Code": "parentBusinessCode" },
        "types": { "Organization": "Organization", "Division": "Division", "Department": "Department", "Team": "Team" }
      }
    },
    {
      "name": "lumera-custom-vocabulary",
      "about": "The primary BYOF demo: noncanonical headers, custom vocabulary, one genuinely ambiguous label.",
      "headers": ["Org Key", "Structure Label", "Upstream Ref", "Layer Label", "Country Footprint"],
      "rows": [
        ["LUM-001", "Lumera Group", "", "Corporate Group", "Tunisia"],
        ["LUM-002", "People & Culture", "LUM-001", "Business Pillar", "France"],
        ["LUM-003", "Finance", "LUM-001", "Business Pillar", "France"],
        ["LUM-004", "Technology", "LUM-001", "Business Pillar", "UAE"],
        ["LUM-005", "Talent Acquisition", "LUM-002", "Operational Function", "Tunisia"],
        ["LUM-006", "Payroll", "LUM-003", "Operational Function", "France"],
        ["LUM-007", "Platform Engineering", "LUM-004", "Operational Function", "UAE"],
        ["LUM-008", "Campus Hiring Squad", "LUM-005", "Delivery Squad", "Tunisia"],
        ["LUM-009", "Payroll Ops Squad", "LUM-006", "Delivery Squad", "France"],
        ["LUM-010", "Core Platform Squad", "LUM-007", "Delivery Squad", "UAE"],
        ["LUM-011", "Data Platform Squad", "LUM-007", "Delivery Squad", "UAE"],
        ["LUM-012", "Shared Payroll Centre", "LUM-001", "Shared Service", "Tunisia"],
        ["LUM-013", "Shared IT Desk", "LUM-001", "Shared Service", "Tunisia"]
      ],
      "expect": {
        "fields": { "Org Key": "businessCode", "Structure Label": "name", "Upstream Ref": "parentBusinessCode", "Layer Label": "type", "Country Footprint": "abstain" },
        "types": { "Corporate Group": "Organization", "Business Pillar": "Business Unit", "Operational Function": "Department", "Delivery Squad": "Team", "Shared Service": "abstain" }
      }
    },
    {
      "name": "english-synonym-headers",
      "about": "English headers Fusion has no alias for.",
      "headers": ["Unit ID", "Unit Title", "Reports Into", "Tier"],
      "rows": [
        ["U1", "Northwind", "", "Company"],
        ["U2", "Retail", "U1", "Division"],
        ["U3", "Wholesale", "U1", "Division"],
        ["U4", "Store Operations", "U2", "Department"],
        ["U5", "Merchandising", "U2", "Department"],
        ["U6", "Key Accounts", "U3", "Department"],
        ["U7", "North Stores Team", "U4", "Team"],
        ["U8", "South Stores Team", "U4", "Team"]
      ],
      "expect": {
        "fields": { "Unit ID": "businessCode", "Unit Title": "name", "Reports Into": "parentBusinessCode", "Tier": "type" },
        "types": { "Company": "Organization", "Division": "Division", "Department": "Department", "Team": "Team" }
      }
    },
    {
      "name": "french-headers-and-types",
